        {
          "id": "9c8e0329-c7cb-4789-8db7-51f03dcf553c",
          "name": "Retrieve Interday Pricing Summaries",
          "request": {
            "name": "Retrieve Interday Pricing Summaries",
            "description": {
              "content": "Returns historical interday summary pricing data for a specified instrument including open, high, low, close, volume, and other summary fields. Supports date range filtering and field selection.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "historical-pricing",
                "v1",
                "views",
                "interday-summaries",
                ":universe"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<dateTime>",
                  "description": "Start date for the data range in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<dateTime>",
                  "description": "End date for the data range in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "<string>",
                  "description": "Time interval for the summaries. Options include daily, weekly, monthly, quarterly, and yearly."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "<integer>",
                  "description": "Maximum number of data points to return."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "Comma-separated list of fields to include in the response."
                },
                {
                  "disabled": false,
                  "key": "adjustments",
                  "value": "<string>",
                  "description": "Comma-separated list of price adjustment types to apply."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "universe",
                  "description": "(Required) Instrument identifier, typically a RIC such as AAPL.O or IBM.N."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
