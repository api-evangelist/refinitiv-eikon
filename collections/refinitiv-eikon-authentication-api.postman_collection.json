      "item": [
        {
          "id": "96d0e7b8-d900-480c-ac05-22efb0969c38",
          "name": "Obtain Access Token",
          "request": {
            "name": "Obtain Access Token",
            "description": {
              "content": "Authenticates and returns an OAuth 2.0 access token using Resource Owner Password Credentials grant type. Access tokens are valid for five minutes. Subsequent token refreshes should use the refresh token grant type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "oauth2",
                "v1",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) OAuth 2.0 grant type. Use password for initial authentication, refresh_token for subsequent requests."
                },
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<string>",
                  "description": "(Required) RDP username or machine account identifier."
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<string>",
                  "description": "(Required) User password for the RDP account."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Application client identifier provided during app registration."
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "Refresh token from a previous authentication response. Required when grant_type is refresh_token."
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "<string>",
                  "description": "Requested scope of access. Default is trapi."
                }
              ]
            }
          },
