          "name": "Request Authentication Token",
          "request": {
            "name": "Request Authentication Token",
            "description": {
              "content": "Authenticates user credentials and returns a session token valid for 24 hours. The token must be included in the Authorization header of all subsequent API requests.",
              "type": "text/plain"
            },
