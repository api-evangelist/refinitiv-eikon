          "name": "Retrieve News Headlines",
          "request": {
            "name": "Retrieve News Headlines",
            "description": {
              "content": "Returns financial news headlines matching the specified query criteria. Supports filtering by topic, instrument, date range, and other parameters. Results include headline text, source, and timestamps.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "news",
                "v1",
                "headlines"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Free-text search query for news headlines. Supports operators and field-specific searches."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "<integer>",
                  "description": "Maximum number of headlines to return."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Pagination cursor for retrieving the next set of results."
                },
                {
                  "disabled": false,
                  "key": "dateFrom",
                  "value": "<dateTime>",
                  "description": "Start date for filtering headlines in ISO 8601 format."
                },
                {
                  "disabled": false,
                  "key": "dateTo",
                  "value": "<dateTime>",
                  "description": "End date for filtering headlines in ISO 8601 format."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
