          "name": "Retrieve a News Story",
          "request": {
            "name": "Retrieve a News Story",
            "description": {
              "content": "Returns the full content of a news story identified by its story identifier. Includes the story body, metadata, subjects, and associated instruments.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "data",
                "news",
                "v1",
                "stories",
                ":storyId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "storyId",
                  "description": "(Required) Unique identifier for the news story."
