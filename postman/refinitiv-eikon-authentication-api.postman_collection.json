                      },
                      "request": {
                        "method": "POST",
                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "application/x-www-form-urlencoded"
                          },
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "body": {
                          "mode": "urlencoded",
                          "urlencoded": [
                            {
                              "description": "(Required) OAuth 2.0 grant type. Use password for initial authentication, refresh_token for subsequent requests.",
                              "key": "grant_type",
                              "value": "password"
                            },
                            {
                              "description": "(Required) RDP username or machine account identifier.",
                              "key": "username",
                              "value": "<string>"
                            },
                            {
                              "description": "(Required) User password for the RDP account.",
                              "key": "password",
                              "value": "<string>"
                            },
                            {
                              "description": "(Required) Application client identifier provided during app registration.",
                              "key": "client_id",
                              "value": "<string>"
                            },
                            {
                              "description": "Refresh token from a previous authentication response. Required when grant_type is refresh_token.",
                              "key": "refresh_token",
                              "value": "<string>"
                            },
                            {
                              "description": "Requested scope of access. Default is trapi.",
                              "key": "scope",
                              "value": "<string>"
                            }
                          ]
                        },
                        "url": {
                          "raw": "{{baseUrl}}/auth/oauth2/v1/token",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "auth",
                            "oauth2",
                            "v1",
                            "token"
                          ]
                        },
                        "description": "Authenticates and returns an OAuth 2.0 access token using Resource Owner Password Credentials grant type. Access tokens are valid for five minutes. Subsequent token refreshes should use the refresh token grant type."
